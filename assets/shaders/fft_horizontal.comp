#version 460 core
// Stockham radix-2 FFT — horizontal (rows) pass.
//
// Unlike a single-workgroup shared-memory FFT (which is capped at the
// workgroup size, e.g. 256), the Stockham formulation ping-pongs between two
// image textures across log2(N) passes. Each pass is a single dispatch driven
// from the CPU with an increasing u_subseq_count (1, 2, 4, ... N/2). This
// removes the shared-memory size limit, so resolutions of 512+ work.
//
// Data layout (preserved from the original pipeline — three complex sequences):
//   Texture A (rgba32f): xy = complex dx,  zw = complex height (h)
//   Texture B (rg32f):   xy = complex dz
//
// Each thread handles ONE butterfly = two output elements, so we launch
// N/2 threads per row.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, rgba32f) uniform readonly  image2D inputA;
layout(binding = 1, rg32f)   uniform readonly  image2D inputB;
layout(binding = 2, rgba32f) uniform writeonly image2D outputA;
layout(binding = 3, rg32f)   uniform writeonly image2D outputB;

uniform int resolution;
uniform int subseqCount;   // 1, 2, 4, ... N/2 across the passes

const float PI = 3.14159265359;

vec2 complexMul(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.y * b.x + a.x * b.y);
}

void main() {
    int threadIdx = int(gl_GlobalInvocationID.x);   // butterfly index within the row [0, N/2)
    int rowIndex  = int(gl_GlobalInvocationID.y);   // which row
    int halfN     = resolution >> 1;
    if (threadIdx >= halfN || rowIndex >= resolution) return;

    int inIdx  = threadIdx & (subseqCount - 1);
    int outIdx = ((threadIdx - inIdx) << 1) + inIdx;

    float angle   = -PI * (float(inIdx) / float(subseqCount));
    vec2  twiddle = vec2(cos(angle), sin(angle));

    // Two input samples spaced N/2 apart on this row
    vec4 aA = imageLoad(inputA, ivec2(threadIdx,         rowIndex));
    vec4 bA = imageLoad(inputA, ivec2(threadIdx + halfN, rowIndex));
    vec2 aB = imageLoad(inputB, ivec2(threadIdx,         rowIndex)).xy;
    vec2 bB = imageLoad(inputB, ivec2(threadIdx + halfN, rowIndex)).xy;

    // Butterfly for each of the three complex sequences: dx (A.xy), h (A.zw), dz (B.xy)
    vec2 tDx = complexMul(twiddle, bA.xy);
    vec2 tH  = complexMul(twiddle, bA.zw);
    vec2 tDz = complexMul(twiddle, bB.xy);

    vec4 outLoA = vec4(aA.xy + tDx, aA.zw + tH);
    vec4 outHiA = vec4(aA.xy - tDx, aA.zw - tH);
    vec2 outLoB = aB + tDz;
    vec2 outHiB = aB - tDz;

    imageStore(outputA, ivec2(outIdx,               rowIndex), outLoA);
    imageStore(outputA, ivec2(outIdx + subseqCount, rowIndex), outHiA);
    imageStore(outputB, ivec2(outIdx,               rowIndex), vec4(outLoB, 0.0, 0.0));
    imageStore(outputB, ivec2(outIdx + subseqCount, rowIndex), vec4(outHiB, 0.0, 0.0));
}
